{
  "expo": {
    "name": "dearday",
    "slug": "dearday",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dearday",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "requireFullScreen": true,
      "bundleIdentifier": "com.koreauniv.dearday",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "카메라로 사진/영상을 촬영합니다.",
        "NSPhotoLibraryUsageDescription": "사진 보관함에서 불러오고 저장합니다.",
        "NSPhotoLibraryAddUsageDescription": "촬영한 미디어를 보관함에 저장합니다.",
        "NSMicrophoneUsageDescription": "영상 촬영 시 소리 녹음을 위해 필요합니다.",
        "NSLocationWhenInUseUsageDescription": "기록에 현재 위치를 추가합니다."
    }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive_icon_foreground.png",
        "backgroundImage": "./assets/images/adaptive_icon_background.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.koreauniv.dearday",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash_icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.785878283817-c2a3fu28mrap3ktgs1q3vhs8u66r09ov"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ad8392b2-46a3-4856-ae38-28e46bb436b6"
      }
    },
    "owner": "dearday"
  }
}
